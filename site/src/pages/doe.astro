---
import Base from '../layouts/Base.astro';
import { caminho, PRODUCAO } from '../config';

// gerada na build, mesmo com o servidor ligado (ver astro.config.mjs)
export const prerender = true;
---
<Base
  title={"Doe | Clube Criacionista de Ciências"}
  desc={"Apoie o Clube Criacionista de Ciências com uma doação única ou mensal. Veja onde o dinheiro é aplicado e acompanhe a prestação de contas."}
  pvbar={"<span><b>PRÉVIA</b> · Página Doe (nova)</span> <span>·</span> <span>Clube Criacionista de Ciências</span> <span>·</span> <a href=\"https://www.clubecriacionista.com/\">ver site atual</a>"}
  rota={"doe"}
>

<!-- ============ TOPO ============ -->
<section class="phero" id="top">
  <div class="orb orb--1"></div>
  <div class="orb orb--2"></div>
  <div class="phero__in">
    <p class="crumb"><a href={caminho("index")}>Home</a> <span>›</span> Doe</p>
    <h1>Faça parte deste projeto</h1>
    <p class="lead">O Clube Criacionista de Ciências é uma entidade sem fins lucrativos e não cobra taxas nem mensalidade das famílias. Você pode fazer parte deste projeto com o seu apoio voluntário pessoal e com doações financeiras, únicas ou mensais.</p>
  </div>
</section>

<!-- ============ POR QUE DOAR ============ -->
<section class="section" id="porque">
  <div class="wrap">
    <div class="note" data-reveal data-previa hidden={PRODUCAO}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
      <div><b>Nesta prévia nenhuma doação é processada.</b> O formulário demonstra o fluxo e as regras. Os números de impacto e os depoimentos estão marcados como exemplo e precisam vir do cliente antes da publicação.</div>
    </div>

    <div class="sec-head" data-reveal> <span class="eyebrow">Como os adultos podem participar</span>
      <h2 class="h2">Duas formas de fazer parte</h2>
    </div>

    <div class="grid grid--2">
      <div class="box" data-reveal>
        <h3>Com o seu tempo</h3>
        <p>Você pode participar como voluntário, com o seu tempo e com o que sabe fazer. Conte para a gente como gostaria de ajudar.</p> <a class="btn btn--ghost btn--sm" href={caminho("contato")}>Quero ser voluntário <span class="btn__arrow">→</span></a>
      </div>
      <div class="box" data-reveal>
        <h3>Com uma doação</h3>
        <p>Uma vez ou todo mês: você escolhe. Você acompanha onde o dinheiro é aplicado e recebe o comprovante por e-mail.</p> <a class="btn btn--ghost btn--sm" href="#doar">Ver formas de doação <span class="btn__arrow">→</span></a>
      </div>
    </div>

    <div class="sec-head" style="margin-top:52px" data-reveal> <span class="eyebrow">Onde o apoio é aplicado</span>
      <p class="lead">O clube se sustenta com a loja e com quem decide apoiar. As doações pagam os kits de experimento, a produção dos vídeos, a manutenção da plataforma, os prêmios do Programa de Recompensas e outros projetos educativos.</p>
    </div>
  </div>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ FORMULÁRIO ============ -->
<section class="section section--soft" id="doar">
  <div class="wrap">
    <div class="sec-head" data-reveal> <span class="eyebrow">Formas de doação</span>
      <h2 class="h2">Escolha como quer apoiar</h2>
      <p class="lead" data-previa hidden={PRODUCAO}>Doação única aceita Pix, cartão e boleto. Doação mensal é só por cartão, porque a cobrança precisa se repetir sozinha.</p>
      <p class="lead" data-producao hidden={!PRODUCAO}>As doações pelo site chegam em breve. Enquanto isso, fale com a gente: respondemos com os dados para apoiar o clube.</p>
    </div>

    <div class="edu">
      <div class="edu__res">
        <div class="box" data-reveal>
          <h3>Transparência</h3>
          <p>Publicamos um relatório com o que entrou e onde foi aplicado. O primeiro sai três meses depois do lançamento do site, e quem doa recebe o link a cada edição nova.</p> <a class="btn btn--ghost btn--sm" href="#transparencia" data-wip="Relatório de transparência" data-previa hidden={PRODUCAO}>Ver o relatório mais recente <span class="btn__arrow">→</span></a>
        </div>
        <div class="box box--soft" data-reveal data-previa hidden={PRODUCAO}>
          <h3>Depoimentos <span class="pill pill--soft">A COLETAR</span></h3>
          <p style="margin-bottom:0">Espaço reservado para dois ou três depoimentos curtos de pais, professores ou apoiadores. Não colocamos texto fictício aqui: depoimento inventado em página de doação é problema sério de confiança.</p>
        </div>
      </div>

      <div class="nl" data-producao hidden={!PRODUCAO}>
        <h3>Doações pelo site: em breve</h3>
        <p class="nl__sub">Estamos finalizando o meio de pagamento. Para apoiar agora, escreva para <a href="mailto:contato@clubecriacionista.org">contato@clubecriacionista.org</a> ou use a <a href={caminho("contato")}>página de contato</a>.</p>
      </div>
<form class="nl form" id="form-doacao" data-previa hidden={PRODUCAO} data-reveal="right" novalidate>
        <h3>Fazer uma doação</h3>
        <p class="nl__sub">Leva menos de um minuto. Você recebe o comprovante por e-mail.</p>

        <fieldset class="field" id="d-freq">
          <legend>Frequência <span class="req">*</span></legend>
          <div class="radios">
            <label class="radio is-on"><input type="radio" name="freq" value="unica" checked><span>Uma vez</span></label>
            <label class="radio"><input type="radio" name="freq" value="mensal"><span>Todo mês</span></label>
          </div>
        </fieldset>

        <div class="field">
          <label>Valor <span class="req">*</span></label>
          <div class="doe__vals" id="d-vals">
            <button class="doe__val" type="button" data-v="25">R$ 25</button>
            <button class="doe__val is-on" type="button" data-v="50">R$ 50</button>
            <button class="doe__val" type="button" data-v="100">R$ 100</button>
            <button class="doe__val" type="button" data-v="200">R$ 200</button>
          </div>
          <input type="number" id="d-outro" name="valor" min="5" step="1" placeholder="Outro valor, em reais" style="margin-top:10px">
        </div>

        <div class="field">
          <label for="d-nome">Nome completo <span class="req">*</span></label>
          <input type="text" id="d-nome" name="nome" placeholder="Seu nome" autocomplete="name" required>
        </div>

        <div class="field">
          <label for="d-email">E-mail <span class="req">*</span></label>
          <input type="email" id="d-email" name="email" placeholder="voce@exemplo.com" autocomplete="email" required>
        </div>

        <div class="field">
          <label for="d-pag">Forma de pagamento <span class="req">*</span></label>
          <div class="sel">
            <select id="d-pag" name="pagamento" required>
              <option value="" selected disabled>Selecione uma opção</option>
              <option value="pix">Pix</option>
              <option value="cartao">Cartão de crédito</option>
              <option value="boleto">Boleto</option>
            </select>
          </div> <span class="err" id="d-pag-err" hidden>A doação mensal precisa de cartão, para a cobrança se repetir automaticamente.</span>
        </div>

        <label class="check" id="d-anon">
          <input type="checkbox" name="anonimo"> <span>Quero doar anonimamente — meu nome não aparece em nenhuma lista pública de apoiadores.</span>
        </label>

        <label class="check" id="d-consent">
          <input type="checkbox" name="consentimento" required> <span>Autorizo o contato por e-mail sobre esta doação e sobre o projeto. Posso cancelar quando quiser. <a href={caminho("politica-de-privacidade")}>Política de privacidade</a></span>
        </label>

        <button class="btn btn--primary" type="submit">Doar <span id="d-resumo">R$ 50 uma vez</span> <span class="btn__arrow">→</span></button>

        <p class="nl__msg" id="d-msg" role="status" aria-live="polite"></p>
        <p class="nl__note">Doação processada por gateway de pagamento. O clube não armazena os dados do seu cartão.</p>
      </form>
    </div>
  </div>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ FAQ ============ -->
<section class="section" id="faq" data-previa hidden={PRODUCAO}>
  <div class="wrap">
    <div class="sec-head" data-reveal> <span class="eyebrow">Dúvidas sobre doar</span>
      <h2 class="h2">Perguntas frequentes</h2>
    </div>

    <div class="faq" data-reveal>
      <div class="acc">
        <button class="acc__q" aria-expanded="false">Posso cancelar a doação mensal quando quiser?<span class="acc__ico"></span></button>
        <div class="acc__a"><div>Pode, a qualquer momento, pela sua área de doador — sem precisar mandar e-mail nem falar com ninguém. Se preferir, dá para pausar por um mês em vez de cancelar.</div></div>
      </div>
      <div class="acc">
        <button class="acc__q" aria-expanded="false">Recebo recibo ou comprovante?<span class="acc__ico"></span></button>
        <div class="acc__a"><div>Sim. O comprovante é enviado por e-mail assim que o pagamento é confirmado, e fica guardado na sua área de doador para baixar quando precisar.</div></div>
      </div>
      <div class="acc">
        <button class="acc__q" aria-expanded="false">Consigo mudar o valor depois?<span class="acc__ico"></span></button>
        <div class="acc__a"><div>Consegue. Na área de doador você altera o valor da doação mensal, troca o cartão ou pausa a cobrança.</div></div>
      </div>
      <div class="acc">
        <button class="acc__q" aria-expanded="false">Meu nome aparece em algum lugar?<span class="acc__ico"></span></button>
        <div class="acc__a"><div>Só se você quiser. Existe a opção de doar anonimamente no formulário, e ela também pode ser mudada depois.</div></div>
      </div>
      <div class="acc">
        <button class="acc__q" aria-expanded="false">Quais formas de pagamento vocês aceitam?<span class="acc__ico"></span></button>
        <div class="acc__a"><div>Doação única: Pix, cartão de crédito ou boleto. Doação mensal: só cartão de crédito, porque é o que permite a cobrança automática todo mês.</div></div>
      </div>
      <div class="acc">
        <button class="acc__q" aria-expanded="false">Como sei que o dinheiro foi bem usado?<span class="acc__ico"></span></button>
        <div class="acc__a"><div>Pelo relatório de transparência, que mostra o que entrou e onde foi aplicado. Quem doa recebe o link a cada edição nova.</div></div>
      </div>
    </div>
  </div>
</section>


<!-- ============ RODAPÉ ============ -->

<script is:inline slot="script">
(function(){
  'use strict';
  var form = document.getElementById('form-doacao');
  if (!form) return;

  var fFreq  = document.getElementById('d-freq');
  var fVals  = document.getElementById('d-vals');
  var fOutro = document.getElementById('d-outro');
  var fNome  = document.getElementById('d-nome');
  var fEmail = document.getElementById('d-email');
  var fPag   = document.getElementById('d-pag');
  var pagErr = document.getElementById('d-pag-err');
  var fConsent = document.getElementById('d-consent');
  var msg    = document.getElementById('d-msg');
  var resumo = document.getElementById('d-resumo');
  var reEmail = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  var mark = function(el, on){ el.classList.toggle('is-error', on); };
  var esc = function(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  };

  var freq = function(){
    var r = form.querySelector('input[name="freq"]:checked');
    return r ? r.value : 'unica';
  };
  var valor = function(){
    if (fOutro.value && parseInt(fOutro.value, 10) > 0) return parseInt(fOutro.value, 10);
    var on = fVals.querySelector('.doe__val.is-on');
    return on ? parseInt(on.getAttribute('data-v'), 10) : 0;
  };
  var fmt = function(v){ return 'R$ ' + v.toLocaleString('pt-BR'); };

  var sync = function(){
    var v = valor();
    resumo.textContent = (v ? fmt(v) : 'agora') + (freq() === 'mensal' ? ' por mês' : ' uma vez');

    // regra do briefing: recorrente só por cartão
    var mensal = freq() === 'mensal';
    Array.prototype.forEach.call(fPag.options, function(o){
      if (o.value === 'pix' || o.value === 'boleto'){
        o.disabled = mensal;
        o.textContent = o.value === 'pix'
          ? (mensal ? 'Pix — indisponível para doação mensal' : 'Pix')
          : (mensal ? 'Boleto — indisponível para doação mensal' : 'Boleto');
      }
    });
    if (mensal && (fPag.value === 'pix' || fPag.value === 'boleto')){
      fPag.value = 'cartao';
    }
    pagErr.hidden = !mensal;
  };

  fFreq.addEventListener('change', function(){
    fFreq.querySelectorAll('.radio').forEach(function(l){
      l.classList.toggle('is-on', l.querySelector('input').checked);
    });
    sync();
  });

  fVals.addEventListener('click', function(e){
    var b = e.target.closest('.doe__val');
    if (!b) return;
    fVals.querySelectorAll('.doe__val').forEach(function(o){ o.classList.toggle('is-on', o === b); });
    fOutro.value = '';
    sync();
  });

  fOutro.addEventListener('input', function(){
    if (fOutro.value) fVals.querySelectorAll('.doe__val').forEach(function(o){ o.classList.remove('is-on'); });
    mark(fOutro, false);
    sync();
  });

  [fNome, fEmail].forEach(function(f){ f.addEventListener('input', function(){ mark(f, false); }); });
  fPag.addEventListener('change', function(){ mark(fPag, false); });
  fConsent.querySelector('input').addEventListener('change', function(){ fConsent.classList.remove('is-error'); });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var problems = [], first = null;
    var fail = function(el, text){ problems.push(text); if (el){ mark(el, true); if (!first) first = el; } };

    if (valor() < 5) fail(fOutro, 'escolha um valor de R$ 5 ou mais');
    if (fNome.value.trim().length < 2) fail(fNome, 'informe seu nome');
    if (!reEmail.test(fEmail.value.trim())) fail(fEmail, 'informe um e-mail válido');
    if (!fPag.value) fail(fPag, 'escolha a forma de pagamento');
    if (!fConsent.querySelector('input').checked){
      fConsent.classList.add('is-error');
      problems.push('marque a autorização de contato');
      if (!first) first = fConsent.querySelector('input');
    }

    if (problems.length){
      msg.className = 'nl__msg bad';
      msg.textContent = 'Falta pouco: ' + problems.join('; ') + '.';
      if (first) first.focus();
      return;
    }

    var anon = form.querySelector('input[name="anonimo"]').checked;
    var dados = {
      frequencia: freq(), valor: valor(), nome: fNome.value.trim(),
      email: fEmail.value.trim(), pagamento: fPag.value, anonimo: anon
    };
    console.log('[prévia] doação:', dados);

    form.innerHTML =
      '<div class="nl__ok">' +
        '<svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.2"/><path d="m8 12.4 2.8 2.8L16 9.8"/></svg>' +
        '<h3>Obrigado, ' + esc(dados.nome.split(' ')[0]) + '!</h3>' +
        '<p class="nl__sub">Sua doação de <b>' + esc(fmt(dados.valor)) + '</b> ' +
          (dados.frequencia === 'mensal' ? 'por mês' : 'única') +
          ' seria confirmada por <b>' + esc(fPag.options[fPag.selectedIndex].textContent) + '</b>' +
          (anon ? ', de forma anônima' : '') + '.</p>' +
        '<p class="nl__note">Esta é uma prévia: nenhum pagamento foi processado. Na versão publicada, o comprovante chega por e-mail e a doação aparece na sua área de doador.</p>' +
      '</div>';
  });

  sync();
})();

</script>
</Base>
