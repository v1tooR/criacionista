---
import Base from '../layouts/Base.astro';
import { caminho, PRODUCAO } from '../config';

// gerada na build, mesmo com o servidor ligado (ver astro.config.mjs)
export const prerender = true;
---
<Base
  title={"Loja | Clube Criacionista de Ciências"}
  desc={"Livros, kits de experimento e materiais educativos. Compre com dinheiro ou resgate com os pontos do membro pesquisador."}
  pvbar={"<span><b>PRÉVIA</b> · Página Loja (nova)</span> <span>·</span> <span>Clube Criacionista de Ciências</span> <span>·</span> <a href=\"https://www.clubecriacionista.com/\">ver site atual</a>"}
  rota={"loja"}
>

<!-- ============ TOPO ============ -->
<section class="phero" id="top">
  <div class="orb orb--1"></div>
  <div class="orb orb--2"></div>
  <div class="phero__in">
    <p class="crumb"><a href={caminho("index")}>Home</a> <span>›</span> Loja</p>
    <h1>Loja do clube</h1>
    <p class="lead">Livros, kits de experimento e materiais educativos. Qualquer pessoa compra com dinheiro; o membro pesquisador também pode resgatar com os pontos que ganhou. O que entra aqui volta para o projeto.</p>
  </div>
</section>

<!-- ============ VITRINE ============ -->
<section class="section" id="vitrine" data-previa hidden={PRODUCAO}>
  <div class="wrap">
    <div class="note" data-reveal data-previa hidden={PRODUCAO}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
      <div><b>Produtos, preços e fotos são exemplos.</b> As imagens são de bancos com licença livre, só para a vitrine não ficar vazia — o catálogo real, com as fotos dos produtos do clube, entra pelo painel do Wix. Use o botão abaixo para ver a loja como um membro logado: é assim que os preços em pontos aparecem.</div>
    </div>

    <div class="filters" data-reveal>
      <label class="search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5" stroke-linecap="round"/></svg>
        <input type="search" id="busca-loja" placeholder="Buscar produto" aria-label="Buscar produto">
      </label>
      <div class="chips" id="chips-loja" role="group" aria-label="Filtrar por categoria">
        <button class="chip is-on" data-cat="todos">Todos</button>
        <button class="chip" data-cat="livros">Livros</button>
        <button class="chip" data-cat="materiais">Materiais educativos</button>
        <button class="chip" data-cat="kits">Kits de experimento</button>
        <button class="chip" data-cat="clube">Itens do clube</button>
        <button class="chip" data-cat="socios">Exclusivos para membros</button>
        <button class="chip" data-cat="novidades">Novidades</button>
      </div>
    </div>

    <div class="box box--soft" data-reveal style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:26px">
      <div> <b id="modo-txt">Você está vendo a loja como visitante.</b>
        <p style="margin:4px 0 0;font-size:14px" id="modo-sub">Os preços aparecem em reais. Membros logados veem também o valor em pontos e o botão de resgate.</p>
      </div>
      <button class="btn btn--ghost btn--sm" id="modo-btn" type="button">Ver como membro logado <span class="btn__arrow">→</span></button>
    </div>

    <p class="acard__meta" id="contagem-loja" style="margin:0 0 18px" aria-live="polite"></p>

    <div class="grid grid--3" id="lista-loja">
      <article class="prod" data-cat="livros" data-pts="450" data-reveal>
        <div class="prod__tags"><span class="prod__tag prod__tag--pts">Você pode adquirir com pontos</span></div>
        <div class="prod__media"><img src="/assets/loja/livro-guia.jpg" alt="Pilha de livros sobre uma mesa, ao lado de flores amarelas" loading="lazy"></div>
        <div class="prod__body">
          <h3>Livro · Guia do jovem pesquisador</h3>
          <p>Como observar, anotar e apresentar uma descoberta. Escrito para a faixa de 9 a 13 anos.</p>
          <div class="prod__price"><span class="prod__brl">R$ 49,90</span><span class="prod__pts pts-only" hidden>ou 450 pontos</span></div>
          <div class="prod__btns"> <a class="btn btn--primary btn--sm" href="#comprar" data-wip="Carrinho e checkout">Comprar</a> <a class="btn btn--ghost btn--sm pts-only" href="#resgatar" data-wip="Resgate por pontos" hidden>Resgatar com pontos</a>
          </div>
        </div>
      </article>

      <article class="prod" data-cat="kits" data-pts="700" data-reveal>
        <div class="prod__tags"> <span class="prod__tag prod__tag--novo">Novidade</span> <span class="prod__tag prod__tag--pts">Você pode adquirir com pontos</span>
        </div>
        <div class="prod__media"><img src="/assets/loja/kit-agua.jpg" alt="Provetas e béquer com líquidos coloridos" loading="lazy"></div>
        <div class="prod__body">
          <h3>Kit de experimentos · Água e densidade</h3>
          <p>Material para cinco experimentos em casa, com roteiro impresso e orientação de segurança.</p>
          <div class="prod__price"><span class="prod__brl">R$ 89,00</span><span class="prod__pts pts-only" hidden>ou 700 pontos</span></div>
          <div class="prod__btns"> <a class="btn btn--primary btn--sm" href="#comprar" data-wip="Carrinho e checkout">Comprar</a> <a class="btn btn--ghost btn--sm pts-only" href="#resgatar" data-wip="Resgate por pontos" hidden>Resgatar com pontos</a>
          </div>
        </div>
      </article>

      <article class="prod" data-cat="socios" data-pts="1200" data-reveal>
        <div class="prod__tags"><span class="prod__tag prod__tag--socio">Exclusivo para membros</span></div>
        <div class="prod__media"><img src="/assets/loja/jaleco.jpg" alt="Jalecos brancos de laboratório pendurados" loading="lazy"></div>
        <div class="prod__body">
          <h3>Jaleco do membro pesquisador</h3>
          <p>Jaleco infantil com o emblema do clube. Só sai por pontos — não está à venda.</p>
          <div class="prod__price"><span class="prod__brl">1.200 pontos</span></div>
          <div class="prod__btns"> <a class="btn btn--primary btn--sm pts-only" href="#resgatar" data-wip="Resgate por pontos" hidden>Resgatar com pontos</a> <span class="prod__off visitante-only">Entre como membro pesquisador para resgatar.</span>
          </div>
        </div>
      </article>

      <article class="prod" data-cat="materiais" data-pts="300" data-reveal>
        <div class="prod__tags"><span class="prod__tag prod__tag--pts">Você pode adquirir com pontos</span></div>
        <div class="prod__media"><img src="/assets/loja/caderno.jpg" alt="Caderno aberto com lápis e apontador" loading="lazy"></div>
        <div class="prod__body">
          <h3>Caderno de campo</h3>
          <p>Caderno pautado com páginas de registro: o que observei, o que achei estranho, o que descobri.</p>
          <div class="prod__price"><span class="prod__brl">R$ 34,90</span><span class="prod__pts pts-only" hidden>ou 300 pontos</span></div>
          <div class="prod__btns"> <a class="btn btn--primary btn--sm" href="#comprar" data-wip="Carrinho e checkout">Comprar</a> <a class="btn btn--ghost btn--sm pts-only" href="#resgatar" data-wip="Resgate por pontos" hidden>Resgatar com pontos</a>
          </div>
        </div>
      </article>

      <article class="prod" data-cat="clube" data-pts="2500" data-reveal>
        <div class="prod__tags"><span class="prod__tag prod__tag--ultimas">Últimas unidades</span></div>
        <div class="prod__media"><img src="/assets/loja/microscopio.jpg" alt="Microscópio óptico visto de perto" loading="lazy"></div>
        <div class="prod__body">
          <h3>Microscópio infantil</h3>
          <p>Microscópio de iniciação com lâminas prontas. O prêmio mais pedido de quem junta pontos.</p>
          <div class="prod__price"><span class="prod__brl">R$ 289,00</span><span class="prod__pts pts-only" hidden>ou 2.500 pontos</span></div>
          <div class="prod__btns"> <a class="btn btn--primary btn--sm" href="#comprar" data-wip="Carrinho e checkout">Comprar</a> <span class="prod__off pts-only" hidden>Faltam 1.720 pontos para resgatar este item.</span>
          </div>
        </div>
      </article>

      <article class="prod" data-cat="livros" data-pts="380" data-reveal>
        <div class="prod__tags"><span class="prod__tag prod__tag--pts">Você pode adquirir com pontos</span></div>
        <div class="prod__media"><img src="/assets/loja/livro-ceu.jpg" alt="Céu azul com nuvens brancas" loading="lazy"></div>
        <div class="prod__body">
          <h3>Livro · Por que o céu é azul?</h3>
          <p>Vinte perguntas que toda criança faz, respondidas sem encurtar a explicação.</p>
          <div class="prod__price"><span class="prod__brl">R$ 42,00</span><span class="prod__pts pts-only" hidden>ou 380 pontos</span></div>
          <div class="prod__btns"> <a class="btn btn--primary btn--sm" href="#comprar" data-wip="Carrinho e checkout">Comprar</a> <a class="btn btn--ghost btn--sm pts-only" href="#resgatar" data-wip="Resgate por pontos" hidden>Resgatar com pontos</a>
          </div>
        </div>
      </article>
    </div>

    <div class="empty" id="vazio-loja" hidden>
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5" stroke-linecap="round"/></svg>
      <h3>Nenhum produto com esses termos</h3>
      <p>Tente outra palavra ou volte para “Todos” para ver o catálogo inteiro.</p>
    </div>
  </div>

    <p class="creditos"> <b>Créditos das fotos de exemplo:</b> livros, caderno, microscópio e céu em domínio público (CC0/PDM);
      vidraria por <a href="https://www.flickr.com/" target="_blank" rel="noopener">Flickr</a> e jalecos no <a href="https://commons.wikimedia.org/wiki/File:Lab_coats.jpg" target="_blank" rel="noopener">Wikimedia Commons</a>, ambos CC BY 2.0.
      A lista completa está em <code>wix-handoff/paginas.md</code>. Na publicação, todas serão trocadas por fotos reais dos produtos.
    </p>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ PRÊMIOS (produção: lidos da coleção Prêmios do Wix) ============ -->
<section class="section" id="premios" data-producao hidden={!PRODUCAO}>
  <div class="wrap">
    <div class="sec-head" data-reveal> <span class="eyebrow">Troque seus pontos</span>
      <h2 class="h2">Prêmios para resgatar com pontos</h2>
      <p class="lead">O responsável pede o resgate pelo painel e o prêmio chega pelos Correios. Compras em dinheiro chegam em breve.</p>
    </div>
    <div class="grid grid--3" id="premios-lista"></div>
    <p class="nl__note" id="premios-vazio" hidden>Os primeiros prêmios estão a caminho. Enquanto isso, vá juntando pontos!</p>
    <div class="cta__btns" style="margin-top:24px"><a class="btn btn--primary" href={caminho("cadastro")}>Resgatar no painel do responsável <span class="btn__arrow">→</span></a></div>
  </div>
</section>

<!-- ============ COMO FUNCIONA A LOJA ============ -->
<section class="section section--soft">
  <div class="wrap">
    <div class="sec-head" data-reveal> <span class="eyebrow">Regras</span>
      <h2 class="h2">Três formas de levar um produto</h2>
      <p class="lead">Elas convivem no mesmo carrinho, mas aparecem separadas para ninguém se confundir.</p>
    </div>

    <div class="grid grid--3">
      <div class="card" data-reveal>
        <div class="card__body">
          <h3 class="card__title">Compra em dinheiro</h3>
          <p class="card__txt">Aberta a qualquer pessoa, com ou sem cadastro. Pagamento por Pix, cartão ou boleto.</p>
        </div>
      </div>
      <div class="card" data-reveal>
        <div class="card__body">
          <h3 class="card__title">Resgate por pontos</h3>
          <p class="card__txt">Só para membros pesquisadores logados. Se faltarem pontos, o botão fica desativado e a tela diz quantos faltam.</p>
        </div>
      </div>
      <div class="card" data-reveal>
        <div class="card__body">
          <h3 class="card__title">Doação avulsa</h3>
          <p class="card__txt">No fim da compra você pode somar uma doação ao projeto, do valor que quiser. É opcional.</p>
        </div>
      </div>
    </div>

    <div class="box" style="margin-top:28px" data-reveal>
      <h3>O carrinho separa o que é compra e o que é resgate</h3>
      <div class="tbl">
        <table>
          <thead><tr><th>Item</th><th>Forma</th><th>Valor</th></tr></thead>
          <tbody>
            <tr><td>Livro · Guia do jovem pesquisador</td><td>Compra em dinheiro</td><td>R$ 49,90</td></tr>
            <tr><td>Caderno de campo</td><td>Resgate por pontos</td><td>300 pontos</td></tr>
            <tr><td>Doação ao projeto</td><td>Opcional no checkout</td><td>R$ 20,00</td></tr>
            <tr><td><b>Total a pagar</b></td><td>Pix, cartão ou boleto</td><td><b>R$ 69,90 + 300 pontos</b></td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin:14px 0 0;font-size:13.5px;color:var(--muted)">Exemplo de como o carrinho se apresenta. O saldo de pontos é sempre calculado no servidor, nunca no navegador.</p>
    </div>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="section">
  <div class="wrap">
    <div class="cta" data-reveal>
      <h2 class="h2">Ainda não é membro pesquisador?</h2>
      <p class="lead">Quem participa do clube junta pontos a cada descoberta aprovada — e troca por itens desta loja.</p>
      <div class="cta__btns"> <a class="btn btn--yellow btn--lg" href={caminho("cadastro")}>Inscrever meu filho <span class="btn__arrow">→</span></a> <a class="btn btn--ghost btn--lg" href={caminho("como-funciona")}>Entender os pontos</a>
      </div>
    </div>
  </div>
</section>


<!-- ============ RODAPÉ ============ -->

<script is:inline slot="script">
(function(){
  'use strict';
  var lista = document.getElementById('lista-loja');
  if (!lista) return;

  /* ---- Filtro por categoria + busca ---- */
  var prods = Array.prototype.slice.call(lista.querySelectorAll('.prod'));
  var chips = Array.prototype.slice.call(document.querySelectorAll('#chips-loja .chip'));
  var busca = document.getElementById('busca-loja');
  var vazio = document.getElementById('vazio-loja');
  var contagem = document.getElementById('contagem-loja');
  var cat = 'todos';

  var norm = function(s){ return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); };

  var aplicar = function(){
    var termo = norm(busca.value.trim());
    var n = 0;
    prods.forEach(function(p){
      var okCat = cat === 'todos' || p.getAttribute('data-cat') === cat;
      var okTermo = !termo || norm(p.textContent).indexOf(termo) > -1;
      var mostra = okCat && okTermo;
      p.hidden = !mostra;
      if (mostra) n++;
    });
    vazio.hidden = n > 0;
    lista.hidden = n === 0;
    contagem.textContent = n === 0 ? '' : n + (n === 1 ? ' produto' : ' produtos');
  };

  chips.forEach(function(ch){
    ch.addEventListener('click', function(){
      cat = ch.getAttribute('data-cat');
      chips.forEach(function(o){ o.classList.toggle('is-on', o === ch); });
      aplicar();
    });
  });
  busca.addEventListener('input', aplicar);
  aplicar();

  /* ---- Alterna entre a visão do visitante e a do membro logado ----
     Demonstra a regra do briefing: preço em pontos e botão de resgate
     só existem para membro autenticado; sem saldo, o resgate fica bloqueado. */
  var btn = document.getElementById('modo-btn');
  var txt = document.getElementById('modo-txt');
  var sub = document.getElementById('modo-sub');
  var socio = false;
  var SALDO = 780;

  btn.addEventListener('click', function(){
    socio = !socio;
    document.querySelectorAll('.pts-only').forEach(function(el){ el.hidden = !socio; });
    document.querySelectorAll('.visitante-only').forEach(function(el){ el.hidden = socio; });

    // sem saldo suficiente o botão de resgate fica desabilitado, com a razão à vista
    prods.forEach(function(p){
      var custo = parseInt(p.getAttribute('data-pts'), 10) || 0;
      var resgate = p.querySelector('[data-wip="Resgate por pontos"]');
      if (!resgate || !socio) return;
      if (custo > SALDO){
        resgate.classList.add('is-off');
        resgate.setAttribute('aria-disabled', 'true');
        resgate.textContent = 'Faltam ' + (custo - SALDO).toLocaleString('pt-BR') + ' pontos';
      } else {
        resgate.classList.remove('is-off');
        resgate.removeAttribute('aria-disabled');
        resgate.textContent = 'Resgatar com pontos';
      }
    });

    btn.textContent = socio ? 'Ver como visitante' : 'Ver como membro logado';
    txt.textContent = socio
      ? 'Você está vendo a loja como Faraday 07, com 780 pontos.'
      : 'Você está vendo a loja como visitante.';
    sub.textContent = socio
      ? 'Agora cada produto mostra o valor em pontos. Onde o saldo não alcança, o resgate aparece bloqueado com o que falta.'
      : 'Os preços aparecem em reais. Membros logados veem também o valor em pontos e o botão de resgate.';
  });
})();

/* Prêmios reais (modo produção): a seção #premios só aparece no site publicado,
   e os dados vêm da coleção Prêmios do Wix por /api/loja/premios (público: nome,
   foto e pontos — nada de dado pessoal). Na prévia a seção fica escondida e nada roda. */
(function(){
  'use strict';
  var sec = document.getElementById('premios');
  var lista = document.getElementById('premios-lista');
  if (!sec || sec.hidden || !lista) return;
  var esc = function(s){ return String(s).replace(/[&<>"']/g, function(c){ return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]; }); };
  fetch('/api/loja/premios', { headers: { Accept: 'application/json' } })
    .then(function(r){ return r.ok ? r.json() : { premios: [] }; })
    .catch(function(){ return { premios: [] }; })
    .then(function(d){
      var ps = (d && d.premios) || [];
      if (!ps.length) { document.getElementById('premios-vazio').hidden = false; return; }
      lista.innerHTML = ps.map(function(p){
        return '<article class="card">' +
          (p.foto ? '<div class="card__media"><img src="' + esc(p.foto) + '" alt="' + esc(p.nome) + '" loading="lazy"></div>' : '') +
          '<div class="card__body"><h3 class="card__title">' + esc(p.nome) + '</h3>' +
          (p.descricao ? '<p class="card__txt">' + esc(p.descricao) + '</p>' : '') +
          '<p class="cad__saldo" style="margin-top:10px"><b>' + p.pontos + '</b> pontos' + (p.esgotado ? ' · <span class="nl__note">esgotado</span>' : '') + '</p></div></article>';
      }).join('');
    });
})();

</script>
</Base>
