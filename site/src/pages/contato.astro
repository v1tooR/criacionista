---
import Base from '../layouts/Base.astro';
---
<Base
  title={"Contato | Clube Criacionista de Ciências"}
  desc={"Fale com o Clube Criacionista de Ciências. Dúvidas de pais, professores, parceiros e imprensa."}
  pvbar={"<span><b>PRÉVIA</b> · Página Contato</span> <span>·</span> <span>Clube Criacionista de Ciências</span> <span>·</span> <a href=\"https://www.clubecriacionista.com/\">ver site atual</a>"}
  rota={"contato"}
>

<!-- ============ TOPO ============ -->
<section class="phero" id="top">
  <div class="orb orb--1"></div>
  <div class="orb orb--2"></div>
  <div class="phero__in">
    <p class="crumb"><a href="/">Home</a> <span>›</span> Contato</p>
    <h1>Fale com o clube</h1>
    <p class="lead">Dúvida sobre a inscrição, sugestão de tema, proposta de parceria ou pedido de imprensa — escreva que a gente responde.</p>
  </div>
</section>

<!-- ============ CONTATO ============ -->
<section class="section" id="falar">
  <div class="wrap">
    <div class="note" data-reveal>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
      <div><b>Falta definir o canal principal.</b> O briefing pede que cliente e agência combinem qual é o caminho oficial (WhatsApp, e-mail ou formulário), o horário de atendimento e o prazo de resposta antes de publicar. Enquanto isso, os blocos abaixo estão marcados como pendentes.</div>
    </div>

    <div class="edu">
      <div class="edu__res">
        <div class="box" data-reveal>
          <h3>Canais</h3>
          <div class="tbl">
            <table>
              <thead><tr><th>Assunto</th><th>Melhor canal</th></tr></thead>
              <tbody>
                <tr><td>Dúvidas de pais e responsáveis</td><td><span class="pill pill--soft">A DEFINIR</span></td></tr>
                <tr><td>Professores e coordenadores</td><td><span class="pill pill--soft">A DEFINIR</span></td></tr>
                <tr><td>Doações e comprovantes</td><td><span class="pill pill--soft">A DEFINIR</span></td></tr>
                <tr><td>Parcerias e imprensa</td><td><span class="pill pill--soft">A DEFINIR</span></td></tr>
              </tbody>
            </table>
          </div>
          <p style="margin:14px 0 0;font-size:13.5px;color:var(--muted)">Sugestão: um e-mail único de atendimento e, se o cliente tiver equipe para manter, um WhatsApp com horário publicado. Prometer canal que ninguém responde é pior do que não ter.</p>
        </div>

        <div class="box box--soft" data-reveal>
          <h3>Antes de escrever</h3>
          <p>Muita dúvida já está respondida nas páginas do clube. Vale olhar antes — a resposta costuma ser mais rápida.</p>
          <ul style="margin:0;padding-left:20px;color:var(--body);line-height:1.75">
            <li><a href="/como-funciona#faq">Como funciona o clube e os pontos</a></li>
            <li><a href="/doe#faq">Dúvidas sobre doação</a></li>
            <li><a href="/concurso">Concurso Criacionista</a></li>
          </ul>
        </div>

        <div class="box box--soft" data-reveal>
          <h3>Atendimento</h3>
          <p style="margin-bottom:0"><span class="pill pill--soft">A DEFINIR</span> Horário de atendimento e prazo de resposta. Assim que o cliente confirmar, o texto entra aqui e na mensagem de confirmação do formulário.</p>
        </div>
      </div>

      <form class="nl form" id="form-contato" data-reveal="right" novalidate>
        <h3>Mandar uma mensagem</h3>
        <p class="nl__sub">Responderemos no e-mail que você informar.</p>

        <div class="field">
          <label for="c-assunto">Assunto <span class="req">*</span></label>
          <div class="sel">
            <select id="c-assunto" name="assunto" required>
              <option value="" selected disabled>Selecione uma opção</option>
              <option>Dúvida sobre a inscrição</option>
              <option>Sou professor ou coordenador</option>
              <option>Doações e comprovantes</option>
              <option>Concurso Criacionista</option>
              <option>Parceria</option>
              <option>Imprensa</option>
              <option>Outro assunto</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="c-nome">Nome <span class="req">*</span></label>
          <input type="text" id="c-nome" name="nome" placeholder="Seu nome" autocomplete="name" required>
        </div>

        <div class="field">
          <label for="c-email">E-mail <span class="req">*</span></label>
          <input type="email" id="c-email" name="email" placeholder="voce@exemplo.com" autocomplete="email" required>
        </div>

        <div class="field">
          <label for="c-msg">Mensagem <span class="req">*</span></label>
          <textarea id="c-msg" name="mensagem" rows="5" placeholder="Conte o que você precisa" required></textarea>
        </div>

        <label class="check" id="c-consent">
          <input type="checkbox" name="consentimento"> <span>Autorizo o uso dos meus dados para responder esta mensagem. <a href="#privacidade" data-wip="Política de privacidade">Política de privacidade</a></span>
        </label>

        <button class="btn btn--primary" type="submit">Enviar mensagem <span class="btn__arrow">→</span></button>

        <p class="nl__msg" id="c-status" role="status" aria-live="polite"></p>
        <p class="nl__note">Não usamos este formulário para enviar newsletter. Para receber os materiais novos, a inscrição é <a href="/#educadores">nesta outra página</a>.</p>
      </form>
    </div>
  </div>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ PARCERIAS ============ -->
<section class="section section--soft">
  <div class="wrap">
    <div class="grid grid--2">
      <div class="box" data-reveal>
        <h3>Parcerias</h3>
        <p>Escolas, igrejas, editoras e projetos que queiram somar com o clube têm um caminho próprio. A página de parcerias continua no ar, agora a partir do rodapé.</p> <a class="btn btn--ghost btn--sm" href="https://www.clubecriacionista.com/s-projects-side-by-side">Ver parcerias <span class="btn__arrow">→</span></a>
      </div>
      <div class="box" data-reveal>
        <h3>Imprensa</h3>
        <p style="margin-bottom:0">Para entrevistas e uso de material do clube, escreva pelo formulário escolhendo o assunto “Imprensa”. <span class="pill pill--soft">A DEFINIR</span> Assessoria ou contato direto.</p>
      </div>
    </div>
  </div>
</section>


<!-- ============ RODAPÉ ============ -->

<script is:inline slot="script">
(function(){
  'use strict';
  var form = document.getElementById('form-contato');
  if (!form) return;

  var fAssunto = document.getElementById('c-assunto');
  var fNome = document.getElementById('c-nome');
  var fEmail = document.getElementById('c-email');
  var fMsg = document.getElementById('c-msg');
  var fConsent = document.getElementById('c-consent');
  var status = document.getElementById('c-status');
  var reEmail = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  var mark = function(el, on){ el.classList.toggle('is-error', on); };
  var esc = function(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  };

  [fAssunto, fNome, fEmail, fMsg].forEach(function(f){
    f.addEventListener('input', function(){ mark(f, false); });
    f.addEventListener('change', function(){ mark(f, false); });
  });
  fConsent.querySelector('input').addEventListener('change', function(){ fConsent.classList.remove('is-error'); });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var problems = [], first = null;
    var fail = function(el, text){ problems.push(text); mark(el, true); if (!first) first = el; };

    if (!fAssunto.value) fail(fAssunto, 'escolha o assunto');
    if (fNome.value.trim().length < 2) fail(fNome, 'informe seu nome');
    if (!reEmail.test(fEmail.value.trim())) fail(fEmail, 'informe um e-mail válido');
    if (fMsg.value.trim().length < 10) fail(fMsg, 'escreva sua mensagem');
    if (!fConsent.querySelector('input').checked){
      fConsent.classList.add('is-error');
      problems.push('marque a autorização de uso dos dados');
      if (!first) first = fConsent.querySelector('input');
    }

    if (problems.length){
      status.className = 'nl__msg bad';
      status.textContent = 'Falta pouco: ' + problems.join('; ') + '.';
      if (first) first.focus();
      return;
    }

    console.log('[prévia] contato:', { assunto: fAssunto.value, nome: fNome.value.trim(), email: fEmail.value.trim() });

    form.innerHTML =
      '<div class="nl__ok">' +
        '<svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.2"/><path d="m8 12.4 2.8 2.8L16 9.8"/></svg>' +
        '<h3>Mensagem enviada</h3>' +
        '<p class="nl__sub">Obrigado, <b>' + esc(fNome.value.trim().split(' ')[0]) + '</b>. Responderemos em <b>' + esc(fEmail.value.trim()) + '</b>.</p>' +
        '<p class="nl__note">Esta é uma prévia: nada foi enviado. O prazo de resposta entra nesta mensagem assim que o cliente definir o atendimento.</p>' +
      '</div>';
  });
})();

</script>
</Base>
