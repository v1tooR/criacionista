---
import Base from '../layouts/Base.astro';
import CardsDePost from '../components/CardsDePost.astro';
import { caminho, caminhoPost, PRODUCAO } from '../config';
import { esquemaNaBuild } from '../formularios';

// gerada na build, mesmo com o servidor ligado (ver astro.config.mjs)
export const prerender = true;

// o esquema de cada formulário é lido do Wix na build e vai embutido na página
// (ver src/formularios.ts); `<` escapado para não fechar o <script> antes da hora
const esquemas = { newsletter: await esquemaNaBuild('newsletter') };
const json = (x: unknown) => JSON.stringify(x ?? null).replace(/</g, '\\u003c');
---
<Base
  title={"Clube Criacionista de Ciências | Ciência, descobertas e fé em um só lugar"}
  desc={"Clube de ciências para crianças de 9 a 13 anos. Pensamento crítico e cosmovisão bíblica: vire membro pesquisador, envie descobertas e ganhe pontos."}
  pvbar={"<span><b>PRÉVIA</b> · Home reformulada do Clube Criacionista de Ciências</span> <span>·</span> <span>Conteúdo, imagens e vídeos reais do site atual</span> <span>·</span> <a href=\"https://www.clubecriacionista.com/\" target=\"_blank\" rel=\"noopener\">ver site atual</a>"}
  rota={"index"}
>

<main id="top">

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero__in">
    <div> <span class="hero__chip" data-enter style="--d:60ms"><b>9 A 13 ANOS</b> Clube de ciências para crianças curiosas</span>

      <h1 data-enter style="--d:140ms">Ciência, descobertas e fé em um só lugar.</h1>

      <p class="hero__sub" data-enter style="--d:230ms">
        O Clube Criacionista de Ciências é o lugar onde crianças de 9 a 13 anos investigam o mundo
        com pensamento crítico e através de uma cosmovisão bíblica. Seu filho vira <strong>um membro pesquisador</strong>, envia as próprias descobertas, ganha pontos e troca
        por recompensas. Tudo inteiramente grátis!
      </p>

      <div class="hero__btns" data-enter style="--d:320ms"> <a class="btn btn--primary btn--lg" href="#cadastro">Inscrever meu filho <span class="btn__arrow">→</span></a> <a class="btn btn--ghost btn--lg" href="#como-funciona">Ver como funciona</a>
      </div>

      <div class="hero__stats" data-enter style="--d:410ms">
        <div class="stat"><div class="stat__n"><span data-count="12">0</span></div><div class="stat__l">publicações no blog</div></div>
        <div class="stat"><div class="stat__n"><span data-count="8">0</span></div><div class="stat__l">vídeos na videoteca</div></div>
        <div class="stat"><div class="stat__n"><span data-count="5">0</span>+</div><div class="stat__l">categorias no blog</div></div>
      </div>
    </div>

    <div class="hero__art">
      <div class="orb orb--1"></div>
      <div class="orb orb--2"></div>
      <div class="hero__ring"></div> <span class="hero__dot" style="background:var(--red);top:6%;left:8%"></span> <span class="hero__dot" style="background:var(--yellow);top:20%;right:2%"></span> <span class="hero__dot" style="background:var(--green);bottom:22%;right:6%"></span> <span class="hero__dot" style="background:var(--purple);bottom:6%;left:20%"></span>

      <div class="hero__frame">
        <figure class="hero__photo">
          <img src="/assets/hero-criancas.webp"
               alt="Duas crianças lendo a Bíblia juntas em uma sala de aula"
               width="786" height="982">
        </figure>
        <div class="hero__badge">
          <img src="/assets/logo.png" alt="Clube Criacionista de Ciências">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ TRÊS CAMINHOS ============ -->
<section class="section" id="caminhos">
  <div class="wrap">
    <div class="sec-head" data-reveal> <span class="eyebrow">Como participar</span>
      <p class="lead">Escolha a forma de se envolver, de acordo com o seu objetivo.</p>
    </div>

    <div class="grid grid--3">
      <article class="path" style="--pc:var(--navy);--d:0ms" data-reveal>
        <div class="path__ico">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 7l9 5 9-5-9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></svg>
        </div>
        <div class="path__kicker">Para famílias</div>
        <h3>Inscreva seu filho</h3>
        <p>Cadastre-se como responsável e crie o perfil de membro pesquisador do seu filho — com apelido público, avatar ilustrado e sua autorização em cada etapa.</p> <a class="btn btn--sm" href="#cadastro">Inscrever meu filho <span class="btn__arrow">→</span></a>
      </article>

      <!-- Renomeado de "Pesquisadores" para "Pais e Professores" (feedback do cliente) -->
      <article class="path" style="--pc:var(--cyan-d);--d:110ms" data-reveal>
        <div class="path__ico">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
        </div>
        <div class="path__kicker">Para quem ensina</div>
        <h3>Pais e Professores</h3>
        <p>Dicas de experimentos para fazer em casa e sugestão de material de apoio para conduzir as atividades de acordo com a cosmovisão bíblica das origens — mais a newsletter que avisa a cada novidade.</p> <a class="btn btn--sm" href="#educadores">Recursos e newsletter <span class="btn__arrow">→</span></a>
      </article>

      <article class="path" style="--pc:var(--green-d);--d:220ms" data-reveal>
        <div class="path__ico">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.5-1.5 3-3.4 3-5.5A5.5 5.5 0 0 0 12 5.4 5.5 5.5 0 0 0 2 8.5c0 2.1 1.5 4 3 5.5l7 7 7-7Z"/></svg>
        </div>
        <div class="path__kicker">Para apoiadores</div>
        <h3>Apoie o projeto</h3>
        <p>Você pode fazer parte deste projeto através do seu apoio financeiro. Você escolhe entre doação única ou mensal, acompanha onde o dinheiro é aplicado e recebe o comprovante por e-mail.</p> <a class="btn btn--sm" href={caminho("doe")}>Quero apoiar <span class="btn__arrow">→</span></a>
      </article>
    </div>
  </div>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ COMO FUNCIONA ============ -->
<section class="section section--soft" id="como-funciona">
  <div class="wrap">
    <div class="sec-head" data-reveal> <span class="eyebrow">Como funciona</span>
      <h2 class="h2">Do cadastro à recompensa, em três passos</h2>
      <p class="lead">O Programa de Recompensas é o motor do clube: investigar dá pontos, e pontos viram prêmios de verdade na loja.</p>
    </div>

    <div class="steps">
      <div class="step" style="--sc:var(--navy)" data-reveal="zoom">
        <div class="step__n">1</div>
        <h3>Vira membro pesquisador</h3>
        <p>O responsável faz o cadastro, autoriza a participação e a criança escolhe seu apelido e avatar. O nome real nunca aparece no ambiente do clube.</p>
      </div>
      <div class="step" style="--sc:var(--cyan-d);--d:120ms" data-reveal="zoom">
        <div class="step__n">2</div>
        <h3>Investiga e envia</h3>
        <p>A cada mês há novas missões. A criança faz o experimento, registra em vídeo, foto ou texto e envia pela área do membro. A equipe avalia e devolve um retorno.</p>
      </div>
      <div class="step" style="--sc:var(--green-d);--d:240ms" data-reveal="zoom">
        <div class="step__n">3</div>
        <h3>Troca pontos por recompensas</h3>
        <p>Descoberta aprovada vira pontos. Os pontos são trocados por livros, kits de experimento e itens exclusivos do clube na loja.</p>
      </div>
    </div>
  </div>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ ESTAÇÃO DOS POR QUES ============ -->
<section class="section estacao" id="estacao">
  <div class="wrap estacao__in">
    <div data-reveal="left">
      <!-- Título "separado" e nova proposta de cor, conforme feedback do cliente -->
      <h2> <span class="estacao__pre">Estação dos</span> <span class="estacao__big">Por <em>Que</em>s</span>
      </h2>
      <p class="lead">
        Esta é a designação das oficinas de experimentação em ciências do Clube — o ambiente
        aonde a pergunta vem antes da resposta. Todo mês um tema novo, experiências para fazer
        em casa e um mural com os registros das experiências de outros membros pesquisadores,
        identificados só pelo apelido.
      </p>

      <ul class="estacao__list">
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg> Tema do mês com missões guiadas</li>
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg> Experimentos com orientação de segurança</li>
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg> Mural das descobertas, sempre por apelido</li>
      </ul> <a class="btn btn--primary" href="#cadastro" style="background:var(--purple)">Conhecer a Estação <span class="btn__arrow">→</span></a>

      <p class="estacao__note"> <b>Sobre o nome:</b> o nome da oficina usa a forma separada e sem acento — <b>por que</b> —
        a que aparece nas perguntas diretas, no sentido de <em>“por qual razão”</em>. É exatamente
        esse o jeito insistente com que a criança tenta entender o motivo de tudo que a cerca.
        A Estação dos por ques quer ajudá-las a encontrar as respostas na melhor sala de aula que
        o Criador nos deixou — a Natureza.
      </p>
    </div>

    <div class="estacao__viz" data-reveal="right">
      <div class="qbox" style="--qc:var(--green)"><div class="qbox__q">Por que</div><p>o céu é azul e o pôr do sol é laranja?</p><small>Tema: Luz e atmosfera</small></div>
      <div class="qbox" style="--qc:var(--purple)"><div class="qbox__q">Por que</div><p>a aranha não gruda na própria teia?</p><small>Tema: Design na natureza</small></div>
      <div class="qbox" style="--qc:var(--cyan)"><div class="qbox__q">Por que</div><p>algumas árvores dadas como extintas voltam a florescer?</p><small>Tema: Sementes e tempo</small></div>
      <div class="qbox" style="--qc:var(--red)"><div class="qbox__q">Por que</div><p>o pica-pau não fica com dor de cabeça?</p><small>Tema: Biomecânica</small></div>
    </div>
  </div>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ CONFIANÇA PARA OS PAIS ============ -->
<section class="section trust" id="seguranca">
  <div class="wrap">
    <div class="sec-head" data-reveal> <span class="eyebrow">Feito com os pais, não apesar deles</span>
      <h2 class="h2">Você no controle, do começo ao fim</h2>
      <p class="lead">Toda a experiência foi desenhada com um princípio: criança protegida e responsável informado.</p>
    </div>

    <div class="grid grid--3">
      <div class="tcard" data-reveal>
        <div class="tcard__ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></div>
        <h3>Você acompanha tudo</h3>
        <p>No painel do responsável você vê cada descoberta enviada, o extrato de pontos, o histórico de resgates e pode revogar autorizações quando quiser.</p>
      </div>
      <div class="tcard" data-reveal style="--d:110ms">
        <div class="tcard__ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.7 8.9a1.9 1.9 0 0 1-1.3 0C6.8 20.5 3.3 18 3.3 13V6.2a1.9 1.9 0 0 1 1.2-1.8l6.8-2.5a1.9 1.9 0 0 1 1.3 0l6.8 2.5A1.9 1.9 0 0 1 20.7 6Z"/></svg></div>
        <h3>Você decide o que aparece</h3>
        <p>Não pedimos RG nem documento da criança. Ela é identificada por um apelido e um avatar ilustrado, e o CPF é sempre do responsável. O rosto não é exigido: se não quiser mostrá-lo, é só borrar a imagem antes de enviar.</p>
      </div>
      <div class="tcard" data-reveal style="--d:220ms">
        <div class="tcard__ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.5L4.6 19a2 2 0 0 0 1.7 3h11.4a2 2 0 0 0 1.7-3L14 9.5V2"/><path d="M8.5 2h7"/><path d="M7 15h10"/></svg></div>
        <h3>Experimentos com orientação de segurança</h3>
        <p>Cada missão traz o passo a passo, a lista de materiais e um aviso claro sobre o que precisa de supervisão de um adulto.</p>
      </div>
    </div>
  </div>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ MOMENTO CRIACIONISTA ============ -->
<section class="section" id="momento">
  <div class="wrap">
    <div class="sec-head sec-head--row" data-reveal>
      <div> <span class="eyebrow">Momento Criacionista</span>
        <h2 class="h2">Uma lição da criação</h2>
        <p class="lead">Uma observação da natureza ligada a um versículo, em dois minutos de leitura.</p>
      </div>
      <div class="railnav" data-rail="momento">
        <button data-dir="-1" aria-label="Anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
        <button data-dir="1" aria-label="Próximo"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="rail" id="rail-momento" data-reveal>
      <CardsDePost categoria="Momento Criacionista" limite={6} cor="tag--mc" chamada="Ler no blog">
<a class="card" href={caminhoPost("egoismo-so-traz-prejuizos")}>
        <div class="card__media"><span class="tag tag--mc">Momento Criacionista</span>
          <img src="/assets/wix/post-egoismo.jpg" alt="Formigas pretas do mediterrâneo" loading="lazy"></div>
        <div class="card__body">
          <h3 class="card__title">Egoísmo só traz prejuízos</h3>
          <p class="card__txt">Não há lugar nas áridas terras do evolucionismo para o altruísmo. Por exemplo, a evolução diz que se eu ajudo você, eu o faço porque vou obter alguma vantagem com isso…</p>
          <div class="card__meta"><span>04 jul 2023</span>·<span>2 min de leitura</span></div> <span class="card__more">Ler no blog <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </div>
      </a> <a class="card" href={caminhoPost("arvore-extinta-esta-florescendo")}>
        <div class="card__media"><span class="tag tag--mc">Momento Criacionista</span>
          <img src="/assets/wix/post-arvore-extinta.jpg" alt="Árvore extinta voltando a florescer" loading="lazy"></div>
        <div class="card__body">
          <h3 class="card__title">Árvore extinta está florescendo</h3>
          <p class="card__txt">Isaías 55:8 “Pois meus pensamentos não são os vossos pensamentos nem os meus caminhos os vossos caminhos, diz o Senhor.” De acordo com o…</p>
          <div class="card__meta"><span>04 jul 2023</span>·<span>2 min de leitura</span></div> <span class="card__more">Ler no blog <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </div>
      </a> <a class="card" href={caminhoPost("eras-de-petrificacao")}>
        <div class="card__media"><span class="tag tag--mc">Momento Criacionista</span>
          <img src="/assets/wix/post-eras-petrificacao.jpg" alt="Formação rochosa petrificada" loading="lazy"></div>
        <div class="card__body">
          <h3 class="card__title">Eras de Petrificação</h3>
          <p class="card__txt">I Coríntios 10:4 “… e beberam da mesma fonte espiritual; porque bebiam de uma pedra espiritual que os seguia. E a pedra era Cristo.”…</p>
          <div class="card__meta"><span>04 jul 2023</span>·<span>2 min de leitura</span></div> <span class="card__more">Ler no blog <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </div>
      </a> <a class="card" href={caminhoPost("a-despensa-do-pica-pau")}>
        <div class="card__media"><span class="tag tag--mc">Momento Criacionista</span>
          <img src="/assets/wix/post-pica-pau.jpg" alt="Pica-pau e sua despensa de sementes" loading="lazy"></div>
        <div class="card__body">
          <h3 class="card__title">A despensa do pica-pau</h3>
          <p class="card__txt">I Reis 17:14 “Porque assim diz o Senhor Deus de Israel, a farinha da tua panela não se acabará, e o azeite da tua botija não faltará, até…”</p>
          <div class="card__meta"><span>04 jul 2023</span>·<span>2 min de leitura</span></div> <span class="card__more">Ler no blog <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </div>
      </a> <a class="card" href={caminhoPost("as-aranhas-sentem-dor")}>
        <div class="card__media"><span class="tag tag--mc">Momento Criacionista</span>
          <img src="/assets/wix/post-aranhas.jpg" alt="Aranha em sua teia" loading="lazy"></div>
        <div class="card__body">
          <h3 class="card__title">As aranhas sentem dor?</h3>
          <p class="card__txt">I Pedro 3:18 “Pois também Cristo morreu uma só vez pelos pecados, o justo pelos injustos para conduzir-vos a Deus; morto, sim, na carne…”</p>
          <div class="card__meta"><span>04 jul 2023</span>·<span>2 min de leitura</span></div> <span class="card__more">Ler no blog <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </div>
      </a> <a class="card" href={caminhoPost("doutora-ra")}>
        <div class="card__media"><span class="tag tag--mc">Momento Criacionista</span>
          <img src="/assets/wix/post-doutora-ra.jpg" alt="Rã sobre folhagem" loading="lazy"></div>
        <div class="card__body">
          <h3 class="card__title">Doutora rã</h3>
          <p class="card__txt">(Publicado no Clube Criacionista do Facebook em 27/06/12) Efésios 6:14-16 “Estai, pois, firmes cingindo-vos com a verdade e vestindo-vos da…”</p>
          <div class="card__meta"><span>22 jan 2023</span>·<span>2 min de leitura</span></div> <span class="card__more">Ler no blog <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </div>
      </a>
      </CardsDePost>
    </div>
  </div>

  <div class="wrap" style="margin-top:8px"> <a class="btn btn--ghost" href={caminho("estudos")} data-reveal>Ver todos os Momentos Criacionistas <span class="btn__arrow">→</span></a>
  </div>
  <div class="wrap totop"><a href="#top">Voltar ao topo <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></a></div>
</section>

<!-- ============ NOTÍCIAS ============ -->
<section class="section section--soft" id="noticias">
  <div class="wrap">
    <div class="sec-head sec-head--row" data-reveal>
      <div> <span class="eyebrow">Notícias</span>
        <h2 class="h2">Novidades do mundo da ciência</h2>
        <p class="lead">Informações ligadas à natureza, educação e ciências, no contexto da visão criacionista.</p>
      </div> <a class="btn btn--ghost btn--sm" href={caminho("estudos")}>Todas as notícias <span class="btn__arrow">→</span></a>
    </div>

