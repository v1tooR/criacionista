---
/**
 * Documentos internos de trabalho — não fazem parte do site.
 *
 * A rota é dinâmica de propósito: `getStaticPaths` devolve lista vazia quando
 * `PRODUCAO` é true, e aí nenhum arquivo é gerado. É a diferença entre "lembrar
 * de apagar antes de subir" e não precisar lembrar. Um arquivo solto em
 * `public/` iria para o ar junto com o site no dia da virada, e ninguém
 * perceberia.
 *
 * Fora do sitemap (ele só varre `src/pages/*.astro`, sem subpasta) e fora do
 * menu. Quem chega aqui é porque recebeu o endereço.
 */
import { PRODUCAO } from '../../config';

export function getStaticPaths() {
  if (PRODUCAO) return [];
  return [{ params: { doc: 'pendencias' } }];
}

const BLOCOS = [
  {
    nome: 'Atendimento',
    onde: 'rodapé de todas as páginas · página Contato',
    sub: 'Hoje o rodapé diz "A DEFINIR" no lugar do canal de atendimento, em todas as páginas do site.',
    trava: true,
    qs: [
      { id: 'canal', t: 'Qual é o canal principal de atendimento?', d: 'WhatsApp, e-mail ou só o formulário do site. É o que o visitante procura primeiro.', tipo: 'select', ops: ['WhatsApp', 'E-mail', 'Formulário do site', 'WhatsApp e e-mail'] },
      { id: 'canal_end', t: 'Qual o número ou endereço desse canal?', d: 'O WhatsApp com DDD, ou o e-mail que vai aparecer no site.' },
      { id: 'horario', t: 'Horário de atendimento', d: 'Exemplo: segunda a sexta, das 9h às 18h.' },
      { id: 'prazo_resp', t: 'Prazo de resposta que vocês conseguem cumprir', d: 'Melhor prometer dois dias e cumprir do que prometer 24h e atrasar.' },
      { id: 'c_pais', t: 'Contato para dúvidas de pais e responsáveis', d: 'Pode ser o mesmo canal principal — se for, escreva "o mesmo".' },
      { id: 'c_prof', t: 'Contato para professores e coordenadores' },
      { id: 'c_doa', t: 'Contato para doações e comprovantes' },
      { id: 'c_imp', t: 'Contato para parcerias e imprensa', d: 'Se existir assessoria, o nome e o contato dela.' },
    ],
  },
  {
    nome: 'Redes sociais',
    onde: 'rodapé de todas as páginas',
    sub: 'O Facebook já está ligado. Os ícones de Instagram e YouTube ainda não levam a lugar nenhum.',
    qs: [
      { id: 'insta', t: 'Endereço do Instagram', d: 'Link completo, ou "não temos" — sem perfil, o ícone sai do rodapé.' },
      { id: 'yt', t: 'Endereço do canal no YouTube', d: 'O mesmo: link completo ou "não temos".' },
    ],
  },
  {
    nome: 'Sistema de pontos',
    onde: 'página Como funciona',
    sub: 'A tabela está montada, com as ações e os prazos. Faltam os números.',
    qs: [
      { id: 'p_desc', t: 'Pontos por enviar uma descoberta de observação', d: 'Um número. Os outros valores se equilibram em volta deste.' },
      { id: 'p_exp', t: 'Pontos por enviar um experimento feito em casa', d: 'Costuma valer mais que a observação, porque dá mais trabalho.' },
      { id: 'p_mes', t: 'Pontos por completar todas as missões do mês' },
      { id: 'p_conc', t: 'Pontos por participar do Concurso Criacionista' },
      { id: 'p_aprov', t: 'Em quanto tempo a equipe aprova um envio?', d: 'O site hoje diz que "depende do volume". Um prazo concreto evita a criança perguntar toda semana.' },
      { id: 'p_val', t: 'Os pontos vencem?', d: 'Nossa recomendação é que não vençam. Quem junta pontos por meses e perde tudo desiste do clube.', tipo: 'select', ops: ['Não vencem', 'Vencem em 6 meses', 'Vencem em 1 ano', 'Vencem no fim do ano letivo', 'Ainda vamos decidir'] },
    ],
  },
  {
    nome: 'Concurso Criacionista',
    onde: 'página Concurso',
    sub: 'A página inteira está montada, cronograma incluído. Faltam o tema e as datas.',
    qs: [
      { id: 'co_tema', t: 'Qual o tema do concurso?' },
      { id: 'co_insc', t: 'Período de inscrições e envio das participações', d: 'Exemplo: de 1 de março a 30 de abril.' },
      { id: 'co_aval', t: 'Período de avaliação da comissão' },
      { id: 'co_res', t: 'Data da divulgação do resultado' },
      { id: 'co_ent', t: 'Data da entrega da premiação' },
      { id: 'co_prem', t: 'Qual é a premiação?', d: 'O que ganha o primeiro lugar, e se há prêmio para os demais colocados.', tipo: 'texto' },
      { id: 'co_reg', t: 'Existe regulamento em PDF?', d: 'Se já existir, mande o arquivo junto com estas respostas.' },
    ],
  },
  {
    nome: 'Pagamento',
    onde: 'páginas Doe e Loja',
    sub: 'Nenhum meio de pagamento está conectado hoje, então os botões de doar e comprar não cobram nada de ninguém.',
    trava: true,
    qs: [
      { id: 'pg_prov', t: 'Qual meio de pagamento vocês vão usar?', d: 'Nossa recomendação é o Wix Pagamentos Brasil: aceita Pix, cartão e boleto, e faz a cobrança mensal automática.', tipo: 'select', ops: ['Wix Pagamentos Brasil', 'Mercado Pago', 'PagBank', 'Pagar.me', 'PayPal', 'Ainda vamos decidir'] },
      { id: 'pg_titular', t: 'A conta será em CPF ou CNPJ?', d: 'É o nome que aparece na fatura do doador. Com CNPJ, passa mais confiança em página de doação.', tipo: 'select', ops: ['CNPJ do clube', 'CPF de pessoa física', 'Ainda vamos decidir'] },
    ],
  },
  {
    nome: 'Política de privacidade',
    onde: 'página Política de privacidade',
    sub: 'A minuta está escrita, cobrindo a LGPD e a regra específica de dados de criança. Faltam os dados do clube para completar.',
    trava: true,
    qs: [
      { id: 'pv_razao', t: 'Razão social', d: 'O nome registrado da instituição que responde pelo clube.' },
      { id: 'pv_cnpj', t: 'CNPJ' },
      { id: 'pv_end', t: 'Endereço completo' },
      { id: 'pv_dpo', t: 'Quem será o encarregado de dados (DPO)?', d: 'A LGPD exige uma pessoa nomeada para receber pedidos sobre dados. Pode ser alguém da equipe, não precisa ser advogado.' },
      { id: 'pv_email', t: 'E-mail para assuntos de privacidade', d: 'Para onde vão pedidos do tipo "apague os dados do meu filho". Pode ser o mesmo e-mail de contato.' },
      { id: 'pv_ret', t: 'Por quanto tempo guardar as mensagens de contato?', d: 'Contado depois da resposta. Sugestão: 12 meses.' },
    ],
  },
  {
    nome: 'Transparência e conteúdo',
    onde: 'páginas Doe e Home',
    sub: 'Três pontas soltas de conteúdo.',
    qs: [
      { id: 'tr_rel', t: 'Já existe relatório de transparência?', d: 'A página de doação promete um relatório com o que entrou e onde foi aplicado. Se ainda não existe, diga quando sai o primeiro.' },
      { id: 'tr_dep', t: 'Depoimentos para a página de doação', d: 'Dois ou três, curtos, de pais, professores ou apoiadores reais, com o nome de quem falou. Não inventamos depoimento em página de doação; sem eles, o bloco sai.', tipo: 'texto' },
      { id: 'tr_exp', t: 'Sugestões de experimentos para a Home', d: 'Um bloco da home está reservado para isso.', tipo: 'texto' },
    ],
  },
];

const TOTAL = BLOCOS.reduce((n, b) => n + b.qs.length, 0);

// gerada na build, mesmo com o servidor ligado (ver astro.config.mjs)
export const prerender = true;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Pendências do site · Clube Criacionista de Ciências</title>
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/site.css">
<style is:inline>
  /* Só o que o design system do site não cobre: a casca deste documento,
     a barra de progresso e o estado "respondida" de um campo. */
  body{background:var(--bg-soft)}

  .doc{max-width:820px;margin:0 auto;padding:0 20px 150px}

  .doc__topo{padding:34px 0 10px}
  .doc__marca{display:flex;align-items:center;gap:12px;margin-bottom:22px}
  .doc__marca img{height:42px;width:auto}
  .doc__marca span{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .doc__topo h1{font-size:clamp(28px,4.6vw,40px);line-height:1.1;letter-spacing:-.015em;margin:0 0 12px}
  .doc__topo .lead{margin:0;max-width:62ch}

  .doc__grupo{margin:38px 0 0}
  .doc__cab{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:0 0 4px}
  .doc__cab h2{margin:0;font-size:24px}
  .doc__onde{font-size:12.5px;font-weight:700;color:var(--muted)}
  .doc__sub{margin:0 0 16px;font-size:14.5px;color:var(--body);max-width:62ch}

  /* cada pergunta é uma caixa do site, com a margem do .field zerada */
  .doc .box{padding:18px 20px;margin:0 0 12px}
  .doc .box .field{margin:0}
  .doc .box.respondida{border-color:rgba(126,186,70,.55)}
  .doc__dica{margin:0 0 9px;font-size:13px;color:var(--muted);line-height:1.5;max-width:60ch}

  .doc__barra{
    position:fixed;left:0;right:0;bottom:0;z-index:40;
    background:rgba(255,255,255,.94);backdrop-filter:blur(10px);
    border-top:1px solid var(--line);
    padding:12px max(20px,env(safe-area-inset-left,0px));
    padding-bottom:calc(12px + env(safe-area-inset-bottom,0px));
  }
  .doc__barra__in{max-width:820px;margin:0 auto;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .doc__prog{flex:1 1 170px;min-width:0}
  .doc__prog b{font-size:13.5px;color:var(--body);font-variant-numeric:tabular-nums}
  .doc__trilho{height:7px;border-radius:999px;background:var(--bg-soft2);margin-top:6px;overflow:hidden}
  .doc__fill{height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,var(--navy),var(--cyan));transition:width .3s var(--ease)}
  .doc__barra .btn{flex:none}

  .doc__saida{margin-top:26px}
  .doc__saida textarea{
    width:100%;min-height:240px;font-family:ui-monospace,Consolas,monospace;font-size:12.5px;
    line-height:1.6;padding:14px;border-radius:var(--r-s);border:1.5px solid var(--line);color:var(--ink);
  }

  .doc__fim{margin-top:40px;padding-top:20px;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}

  @media (max-width:520px){
    .doc .box{padding:16px}
    .doc__barra__in{gap:10px}
    .doc__barra .btn{flex:1 1 auto}
  }
  @media print{
    .doc__barra,.doc__saida{display:none}
    body{background:#fff}
  }
</style>
</head>
<body>

<div class="doc">

  <header class="doc__topo">
    <div class="doc__marca">
      <img src="/assets/logo.png" alt="Clube Criacionista de Ciências">
      <span>Documento de trabalho</span>
    </div>
    <h1>O que falta para publicar</h1>
    <p class="lead">O site novo está pronto de layout, navegação e conteúdo. Estes são os pontos que só o clube pode responder — cada um deles aparece hoje no site como <b>A DEFINIR</b>.</p>
  </header>

  <div class="note">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 8h.01M11 12h1v4h1"></path></svg>
    <div><b>Como usar.</b> Preencha o que souber — não precisa ser tudo de uma vez. O que você digitar fica salvo neste navegador, neste aparelho, então dá para fechar e voltar depois. No fim, o botão <b>Gerar respostas</b> monta o texto pronto para colar de volta.</div>
  </div>

  {BLOCOS.map((b) => (
    <section class="doc__grupo">
      <div class="doc__cab">
        <h2>{b.nome}</h2>
        <span class="doc__onde">{b.onde}</span>
        {b.trava && <span class="pill">TRAVA A PUBLICAÇÃO</span>}
      </div>
      <p class="doc__sub">{b.sub}</p>

      {b.qs.map((q) => (
        <div class="box form" id={'box-' + q.id}>
          <div class="field">
            <label for={'c-' + q.id}>{q.t}</label>
            {q.d && <p class="doc__dica">{q.d}</p>}
            {q.tipo === 'select' ? (
              <div class="sel">
                <select id={'c-' + q.id} data-q={q.id}>
                  <option value="">Selecione…</option>
                  {q.ops.map((o) => <option value={o}>{o}</option>)}
                </select>
              </div>
            ) : q.tipo === 'texto' ? (
              <textarea id={'c-' + q.id} data-q={q.id} rows="4"></textarea>
            ) : (
              <input type="text" id={'c-' + q.id} data-q={q.id} />
            )}
          </div>
        </div>
      ))}
    </section>
  ))}

  <div class="doc__saida" id="saida" hidden>
    <div class="box">
      <h3>Pronto — copie e cole de volta</h3>
      <textarea id="texto" readonly aria-label="Respostas reunidas, prontas para copiar"></textarea>
      <p class="nl__note" id="avisoCopia">Se o botão não copiar sozinho, selecione o texto acima e copie à mão.</p>
    </div>
  </div>

  <p class="doc__fim">
    Documento de trabalho da reformulação de clubecriacionista.com. Não faz parte do site:
    some sozinho da build quando o site entrar no ar.
  </p>

</div>

<div class="doc__barra">
  <div class="doc__barra__in">
    <div class="doc__prog">
      <b id="progTxt">0 de {TOTAL} respondidas</b>
      <div class="doc__trilho"><div class="doc__fill" id="progFill"></div></div>
    </div>
    <button class="btn btn--ghost btn--sm" type="button" id="btnLimpar">Limpar</button>
    <button class="btn btn--primary" type="button" id="btnGerar">Gerar respostas <span class="btn__arrow">→</span></button>
  </div>
</div>

<script is:inline define:vars={{ BLOCOS }}>
(function(){
  'use strict';

  var CHAVE = 'ccc-pendencias-v1';
  var dados = {};
  try { dados = JSON.parse(localStorage.getItem(CHAVE) || '{}') || {}; } catch (e) { dados = {}; }
  var salvar = function(){
    // janela anônima ou cookies bloqueados: segue funcionando, só não lembra
    try { localStorage.setItem(CHAVE, JSON.stringify(dados)); } catch (e) {}
  };

  var todas = [];
  BLOCOS.forEach(function(b){ b.qs.forEach(function(q){ todas.push(q); }); });

  var marca = function(id){
    var cx = document.getElementById('box-' + id);
    if (cx) cx.classList.toggle('respondida', !!String(dados[id] || '').trim());
  };

  var progresso = function(){
    var feitas = todas.filter(function(q){ return String(dados[q.id] || '').trim(); }).length;
    document.getElementById('progTxt').textContent = feitas + ' de ' + todas.length + ' respondidas';
    document.getElementById('progFill').style.width = (feitas / todas.length * 100) + '%';
  };

  todas.forEach(function(q){
    var campo = document.getElementById('c-' + q.id);
    if (!campo) return;
    campo.value = dados[q.id] || '';
    var anota = function(){ dados[q.id] = campo.value; salvar(); marca(q.id); progresso(); };
    campo.addEventListener('input', anota);
    campo.addEventListener('change', anota);
    marca(q.id);
  });
  progresso();

  document.getElementById('btnGerar').addEventListener('click', function(){
    var linhas = ['PENDÊNCIAS DO SITE — CLUBE CRIACIONISTA DE CIÊNCIAS',
                  'Preenchido em ' + new Date().toLocaleDateString('pt-BR'), ''];
    var faltam = [];

    BLOCOS.forEach(function(b){
      var feitas = b.qs.filter(function(q){ return String(dados[q.id] || '').trim(); });
      if (!feitas.length) return;
      linhas.push('## ' + b.nome.toUpperCase());
      feitas.forEach(function(q){
        linhas.push('- ' + q.t);
        linhas.push('  ' + String(dados[q.id]).trim().replace(/\n/g, '\n  '));
      });
      linhas.push('');
    });

    todas.forEach(function(q){ if (!String(dados[q.id] || '').trim()) faltam.push(q.t); });
    if (faltam.length){
      linhas.push('## AINDA SEM RESPOSTA (' + faltam.length + ')');
      faltam.forEach(function(t){ linhas.push('- ' + t); });
    }

    var texto = linhas.join('\n');
    var saida = document.getElementById('saida');
    var campo = document.getElementById('texto');
    var aviso = document.getElementById('avisoCopia');
    saida.hidden = false;
    campo.value = texto;
    saida.scrollIntoView({ behavior: 'smooth', block: 'start' });

    var manual = function(){
      campo.select();
      aviso.textContent = 'Não consegui copiar sozinho — o texto já está selecionado, use copiar do seu aparelho.';
    };
    try {
      navigator.clipboard.writeText(texto).then(function(){
        aviso.textContent = 'Copiado. Agora é só colar na conversa.';
      }, manual);
    } catch (e) { manual(); }
  });

  /* confirmação na própria página, para não apagar tudo num toque sem querer */
  var btn = document.getElementById('btnLimpar'), armado = false, relogio;
  btn.addEventListener('click', function(){
    if (!armado){
      armado = true; btn.textContent = 'Apagar tudo?';
      relogio = setTimeout(function(){ armado = false; btn.textContent = 'Limpar'; }, 4000);
      return;
    }
    clearTimeout(relogio); armado = false; btn.textContent = 'Limpar';
    dados = {}; salvar();
    todas.forEach(function(q){
      var c = document.getElementById('c-' + q.id);
      if (c) c.value = '';
      marca(q.id);
    });
    document.getElementById('saida').hidden = true;
    progresso();
  });
})();
</script>

</body>
</html>
