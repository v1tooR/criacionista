        { "label": "Qual é a sua função?", "kind": "text", "hidden": true, "placeholder": "Descreva em poucas palavras" },
        { "label": "Nome", "kind": "firstName", "required": true, "placeholder": "Seu nome" },
        { "label": "E-mail", "kind": "email", "required": true, "placeholder": "voce@exemplo.com" },
        { "label": "Gênero", "kind": "radio", "required": true, "choices": ["Feminino", "Masculino", "Prefiro não informar"] },
